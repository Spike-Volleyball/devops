# Staging Caddyfile — Cloudflare proxy (orange cloud) handles TLS, Caddy serves HTTP only
{
    auto_https off
    servers {
        client_ip_headers X-Forwarded-For
        timeouts {
            read_header 10s
        }
    }
}

(common_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Robots-Tag "noindex, nofollow"
        X-Frame-Options DENY
        X-XSS-Protection "0"
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

# The API's routing, shared by the public API site and the internal one below it: the SignalR
# hubs, the admin-console deny and the per-service routes.
(api_routes) {
    request_body {
        max_size 10MB
    }

    # SignalR WebSocket hubs
    handle /events/hubs/* {
        uri strip_prefix /events
        reverse_proxy events-service:5010 {
            flush_interval -1
            transport http {
                read_timeout 24h
                write_timeout 24h
            }
        }
    }
    handle /messages/hubs/* {
        uri strip_prefix /messages
        reverse_proxy messages-service:5180 {
            flush_interval -1
            transport http {
                read_timeout 24h
                write_timeout 24h
            }
        }
    }
    handle /notifications/hubs/* {
        uri strip_prefix /notifications
        reverse_proxy notifications-service:5030 {
            flush_interval -1
            transport http {
                read_timeout 24h
                write_timeout 24h
            }
        }
    }
    handle /profiles/hubs/* {
        uri strip_prefix /profiles
        reverse_proxy profiles-service:5170 {
            flush_interval -1
            transport http {
                read_timeout 24h
                write_timeout 24h
            }
        }
    }
    handle /social/hubs/* {
        uri strip_prefix /social
        reverse_proxy social-service:5040 {
            flush_interval -1
            transport http {
                read_timeout 24h
                write_timeout 24h
            }
        }
    }
    handle /payments/hubs/* {
        uri strip_prefix /payments
        reverse_proxy payments-service:5050 {
            flush_interval -1
            transport http {
                read_timeout 24h
                write_timeout 24h
            }
        }
    }
    handle /coaching/hubs/evaluation* {
        uri strip_prefix /coaching
        reverse_proxy coaching-service:5060 {
            flush_interval -1
            transport http {
                read_timeout 24h
                write_timeout 24h
            }
        }
    }

    # The admin console's endpoints, on every service that has them.
    #
    # The console reaches the services directly over the compose network, never through
    # this gateway, so nothing legitimate arrives here. The services check the console's
    # shared secret themselves and that is the real control; this is a second layer.
    #
    # Case-insensitive: ASP.NET routes are, so /auth/v1/Admin/ reaches the same endpoint
    # and a case-sensitive rule would be walked straight around. Placed above the service
    # routes because `handle` blocks are mutually exclusive and matched in file order.
    @admin_endpoints path_regexp (?i)^/(auth|clubs)/v[0-9]+/admin/
    handle @admin_endpoints {
        respond 403
    }

    # REST API routes
    handle_path /auth/* {
        reverse_proxy auth-service:5005
    }
    handle_path /events/* {
        reverse_proxy events-service:5010
    }
    handle_path /clubs/* {
        reverse_proxy clubs-service:5020
    }
    handle_path /profiles/* {
        reverse_proxy profiles-service:5170
    }
    handle_path /messages/* {
        reverse_proxy messages-service:5180
    }
    handle_path /notifications/* {
        reverse_proxy notifications-service:5030
    }
    handle_path /social/* {
        reverse_proxy social-service:5040
    }
    handle_path /coaching/* {
        reverse_proxy coaching-service:5060
    }
    handle_path /payments/* {
        reverse_proxy payments-service:5050
    }
}

# API domain — routes to backend microservices
staging-api.volleyspike.app:80 {
    import common_headers
    import api_routes

    # Fallback: 404 for unknown API routes
    handle {
        respond "Not Found" 404
    }

    encode zstd gzip {
        minimum_length 256
    }
}

# Internal API site — the frontend's own server-side reads (INTERNAL_API_URL=http://caddy:8081).
# Plain HTTP on a port compose does not publish, so only containers on volleyer-network reach it;
# the same reads through staging-api.volleyspike.app left the box, crossed Cloudflare and came
# back. The same routes as the public site, so an SSR read is routed, headed and denied exactly as
# the browser's would be. No compression: it would cost CPU at both ends of a hop that never
# leaves the host.
http://:8081 {
    import common_headers

    # Its own file, so the frontend's reads can be timed on their own.
    log {
        output file /var/log/caddy/access-internal.log {
            roll_size 50MiB
            roll_keep 5
        }
        format json
    }

    import api_routes

    handle {
        respond "Not Found" 404
    }
}

# Frontend domain — routes to Next.js
staging.volleyspike.app:80 staging-app.volleyspike.app:80 {
    import common_headers

    request_body {
        max_size 10MB
    }

    # Everything else -> Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }

    encode zstd gzip {
        minimum_length 256
    }
}
